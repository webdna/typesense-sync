{#
  A collection's page: the collection switcher (when several are declared), the Rules and Synonyms
  tabs, and the state banner (§4 States, BR-14) above whichever screen is shown. The banner is built
  by SectionController::banner(); it is empty while both sets are in step. *Push now* posts by
  script, so it works inside an edit screen's form too.

  A child sets `title`, `crumbs` or `tabs` before extending to replace them, and fills `tab`.

  Test hooks: data-ts-banner on the banner, data-ts-banner-line="<rules|synonyms|>" with
  data-state="not-live|out-of-step|unknown" on each line, data-ts-action="push" on Push now.
#}
{% extends '_layouts/cp' %}

{% set title = title ?? 'Typesense'|t('typesense-sync') %}
{% set docTitle = (title != 'Typesense'|t('typesense-sync') ? title ~ ' - ') ~ collection ~ ' - ' ~ 'Typesense'|t('typesense-sync') %}
{% set tabUrls = {
  rules: cpUrl(sectionUri ~ '/' ~ collection ~ '/rules'),
  synonyms: cpUrl(sectionUri ~ '/' ~ collection ~ '/synonyms'),
} %}
{% set crumbs = crumbs ?? (collections|length > 1 ? [{label: 'Typesense'|t('typesense-sync'), url: cpUrl(sectionUri)}] : []) %}
{% set tabs = tabs ?? {
  rules: {label: 'Rules'|t('typesense-sync'), url: tabUrls.rules},
  synonyms: {label: 'Synonyms'|t('typesense-sync'), url: tabUrls.synonyms},
} %}
{% set selectedTab = kind %}

{% block contextMenu %}
  {% if collections|length > 1 %}
    {{ disclosureMenu(collections|map(handle => {
      label: handle,
      url: cpUrl(sectionUri ~ '/' ~ handle ~ '/' ~ kind),
      selected: handle == collection,
    }), {
      withButton: true,
      autoLabel: true,
      buttonAttributes: {class: ['btn', 'menubtn'], 'aria-label': 'Collection'|t('typesense-sync')},
    }) }}
  {% endif %}
{% endblock %}

{% block content %}
  {% if banner.lines %}
    <div id="ts-banner" class="pane" data-ts-banner>
      {% for line in banner.lines %}
        <p class="warning with-icon" data-ts-banner-line="{{ line.kind }}" data-state="{{ line.state }}">{{ line.text }}</p>
      {% endfor %}
      {% if banner.push %}
        <button type="button" class="btn" id="ts-push" data-ts-action="push">{{ 'Push now'|t('typesense-sync') }}</button>
        {% js %}
          document.getElementById('ts-push').addEventListener('click', (event) => {
            const button = event.currentTarget;
            button.classList.add('loading');
            Craft.sendActionRequest('POST', 'typesense-sync/rules/push', {data: {collection: {{ collection|json_encode|raw }}}})
              .then((response) => {
                Craft.cp.displaySuccess(response.data.message);
                document.getElementById('ts-banner').remove();
              })
              .catch(({response}) => Craft.cp.displayError(response?.data?.message))
              .finally(() => button.classList.remove('loading'));
          });
        {% endjs %}
      {% endif %}
    </div>
  {% endif %}

  {% block tab %}{% endblock %}
{% endblock %}
